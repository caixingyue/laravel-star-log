{
    "name": "caixingyue/laravel-star-log",
    "description": "This package enhances the Laravel log format. It can inject request IDs, Artisan IDs, and queue IDs, and supports route request and response logging, HTTP client request and response logging, SQL query logging, and more.",
    "keywords": [
        "caixingyue",
        "laravel",
        "laravel-star-log"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/caixingyue/laravel-star-log/issues",
        "source": "https://github.com/caixingyue/laravel-star-log"
    },
    "authors": [
        {
            "name": "xingyue cai",
            "email": "xinghuangying@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "php-64bit": "^8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "guzzlehttp/guzzle": "^7.15.5",
        "guzzlehttp/psr7": "^2.13.1",
        "laravel/framework": "^12.69 || ^13.30",
        "mobiledetect/mobiledetectlib": "^4.8",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1 || ^9.0 || ^10.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.50 || ^12.5.8"
    },
    "autoload": {
        "psr-4": {
            "Caixingyue\\LaravelStarLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Caixingyue\\LaravelStarLog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Caixingyue\\LaravelStarLog\\StarLogServiceProvider"
            ],
            "aliases": {
                "StarLog": "Caixingyue\\LaravelStarLog\\Facades\\StarLog"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
